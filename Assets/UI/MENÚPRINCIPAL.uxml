        </ui:VisualElement>
        <ui:VisualElement name="BOTONES_IZQ" style="flex-grow: 1; background-size: 100% 100%; position: absolute; width: 50%; height: 30%; align-items: flex-end; align-self: flex-start; align-content: stretch; justify-content: flex-start; margin-top: 350px;">
            <ui:Button text="Jugar" name="PlayButton" class="boton" />
