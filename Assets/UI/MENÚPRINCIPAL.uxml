        </ui:VisualElement>
        <ui:VisualElement name="OpcionesAccesibilidad" style="flex-grow: 1; position: absolute; width: 260px; height: 100px; align-self: flex-end; justify-content: flex-start; align-items: auto; top: 360px; background-color: rgb(48, 25, 52); flex-direction: row; right: 40px; font-size: 24px;">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 450px; height: 50%; flex-direction: row; align-items: center; align-content: auto; align-self: flex-end; justify-content: flex-start; font-size: 20px;">
