<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu_Principal.uss?fileID=7433441132597879392&amp;guid=095c33b3e5801374db20b043739f29b3&amp;type=3#Menu_Principal" />
    <ui:VisualElement name="background" style="flex-grow: 1; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Im%C3%A1genes/Fondo%20con%20marco.png?fileID=2800000&amp;guid=18e221996beadbe4ab38063647d8aa9f&amp;type=3#Fondo con marco&quot;); background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255);">
        <ui:VisualElement name="ART_CHAMP" style="flex-grow: 1; background-size: 250px 250px; width: 100%; height: 40%; background-image: url(&quot;project://database/Assets/Im%C3%A1genes/IMG_0961.PNG?fileID=2800000&amp;guid=a050b50f2e93b7041873d2b0dad79c24&amp;type=3#IMG_0961&quot;); align-content: auto; align-self: auto; justify-content: flex-start; align-items: auto; top: 60px; position: absolute;" />
        <ui:VisualElement name="AUDIO" style="flex-grow: 1; background-size: 100% 100%; height: 15%; background-image: none; width: 100%; margin-top: 26%; position: absolute; align-items: center; align-self: flex-start; justify-content: center; align-content: stretch; flex-direction: row;">
            <ui:Button name="Music" class="music" style="width: 40px; height: 40px; margin-right: 10px;" />
